rules_version = '2';

// ASTSPARES Firestore security rules.
// Catalog is world-readable (it's the public, SEO-indexed product data).
// RFQs can be CREATED by anyone (the public quote form) but only READ/UPDATED
// by admins. Admin = an existing /admins/{uid} document.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public catalog — read by anyone, written only by admins.
    match /products/{partNumber} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Vendors & sourcing — backend only. No public read (cost/vendor data must
    // never reach the client catalog); admin-only read + write.
    match /vendors/{id} {
      allow read, write: if isAdmin();
    }
    match /vendorOfferings/{id} {
      allow read, write: if isAdmin();
    }

    // Category tree — public read, admin write.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Editable site content (hero, footer) — public read, admin write.
    match /site/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Inventory — admins only (exposed to the catalog via the denormalised
    // inStock flag on the product, not read directly by the public).
    match /inventory/{partNumber} {
      allow read, write: if isAdmin();
    }

    // RFQs.
    //  - online: a signed-in buyer creates their own (channel 'online', buyerUid == them)
    //  - offline: an admin enters an order from outside the system (channel 'offline')
    //  Readable by admins and by the owning buyer (for the in-app quote, later).
    match /rfqs/{rfqNo} {
      allow create: if isValidNewRfq();
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.buyerUid == request.auth.uid);
      // Buyer may only move their own RFQ through accept/negotiate states.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.buyerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'acceptedQuoteId', 'acceptedAt',
                           'buyerPoDocUrl', 'buyerPoDocPath', 'buyerPoUploadedAt', 'updatedAt'])
            && request.resource.data.status in ['Quoted', 'Negotiating', 'Won']);
      allow delete: if isAdmin();

      // Budgetary quotes — admin writes, the owning buyer reads.
      match /quotes/{quoteId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/rfqs/$(rfqNo)).data.buyerUid == request.auth.uid);
        allow create, update, delete: if isAdmin();
      }

      // Negotiation thread — admin and the owning buyer can post and read.
      match /messages/{msgId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/rfqs/$(rfqNo)).data.buyerUid == request.auth.uid);
        allow create: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/rfqs/$(rfqNo)).data.buyerUid == request.auth.uid
              && request.resource.data.senderUid == request.auth.uid
              && request.resource.data.senderRole == 'buyer'
              && request.resource.data.body is string
              && request.resource.data.body.size() > 0);
      }

      function isValidNewRfq() {
        let d = request.resource.data;
        return d.contact.email is string
          && d.contact.email.matches('^[^@]+@[^@]+\\.[^@]+$')
          && d.contact.name is string && d.contact.name.size() > 0
          && d.contact.company is string && d.contact.company.size() > 0
          && d.items is list && d.items.size() > 0 && d.items.size() <= 200
          && (
            // online: signed-in buyer submitting for themselves
            (isSignedIn() && d.channel == 'online'
              && d.status == 'Pending'
              && d.buyerUid == request.auth.uid
              && d.buyerId is string && d.companyId is string)
            // offline: admin-entered record (status set by admin)
            || (isAdmin() && d.channel == 'offline' && d.status is string)
          );
      }
    }

    // Company master list. Signed-in users may browse (to pick during
    // onboarding) and add a new company, which lands unverified for an admin
    // to confirm. Admins manage everything.
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.verified == false;
      allow update, delete: if isAdmin();

      // A company's sites / terminals.
      match /locations/{locationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        allow update, delete: if isAdmin();
      }
    }

    // Buyer profiles. A buyer owns their own record (keyed off uid); admins
    // see and manage all. Online buyers create their own at onboarding.
    match /buyers/{buyerId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.channel == 'online'
          && request.resource.data.verified == false
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.companyId is string);
      // Buyer may amend only their own contact fields; admins may change anything.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'phone', 'dialCode', 'country', 'designation',
                           'department', 'locationId', 'locationName', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Purchase orders — admin enters/manages all data; the owning buyer (online)
    // may read their own. Offline POs carry no buyerUid, so they're admin-only.
    match /purchaseOrders/{poNumber} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.buyerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Atomic ID counters — minted only by the mintSequence Cloud Function
    // (Admin SDK, which bypasses these rules). No client access.
    match /counters/{name} {
      allow read, write: if false;
    }

    // Admin registry — readable by signed-in users (to self-check), never
    // writable from the client. Grant admin via console or a trusted script.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
