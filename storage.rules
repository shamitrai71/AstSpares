rules_version = '2';

// Product images, datasheets, drawings — public read, admin write.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{partNumber}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Purchase-order documents — private. Readable/writable only by an admin
    // or the buyer who owns the parent RFQ. Path: purchaseorders/{rfqNo}/...
    match /purchaseorders/{rfqNo}/{file=**} {
      function isAdmin() {
        return request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
      }
      function ownsRfq() {
        return request.auth != null
          && firestore.get(/databases/(default)/documents/rfqs/$(rfqNo)).data.buyerUid
             == request.auth.uid;
      }
      allow read, write: if isAdmin() || ownsRfq();
    }
  }
}
